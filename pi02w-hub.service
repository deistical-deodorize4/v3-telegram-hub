[Unit]
Description=pi02w-hub — Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__REPO_PATH__
ExecStart=__REPO_PATH__/.venv/bin/python __REPO_PATH__/telegram_bot/bot.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Reminders & weather use naive datetime.now(); must be Europe/Madrid time.
Environment=TZ=Europe/Madrid

# Harden the service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

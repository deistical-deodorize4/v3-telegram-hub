TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_numeric_user_id
AEMET_API_KEY=your_aemet_key_here
# Printing needs ghostscript on the Pi:  sudo apt install ghostscript
PRINTER_ADDR=192.168.1.x

# --- MESH WEATHER (Meshtastic solar node via the BLE bridge) ---
# Node ID of your solar node, as shown in the Meshtastic app
MESH_NODE_ID=!9e1d5437
# The docker stack publishes the bridge stream on the Pi's loopback
MESH_HOST=127.0.0.1
MESH_PORT=4403
# Seconds to wait for a telemetry reply over LoRa (default 25)
MESH_TELEMETRY_TIMEOUT=25
# Seconds to wait for the bridge handshake / node map (default 10)
MESH_CONNECT_TIMEOUT=10
# Morning push time (Europe/Madrid), same as the AEMET brief (default 09:00)
MESH_MORNING_HOUR=9
MESH_MORNING_MINUTE=0